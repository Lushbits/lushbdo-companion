<Project Sdk="Microsoft.NET.Sdk">

  <!-- The offline OCR eval harness (#18): runs pipeline variants and, later,
       candidate engines over the same trace-corpus images and reports
       per-line metrics. Dev tool only — never shipped, never a dependency
       of the tray exe. Same TFM as the app so Windows.Media.Ocr (the
       baseline every candidate has to beat) is reachable. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>false</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\LushbdoCompanion\LootParser.cs" Link="app\LootParser.cs" />
    <Compile Include="..\LushbdoCompanion\TextKeyer.cs" Link="app\TextKeyer.cs" />
    <Compile Include="..\LushbdoCompanion\LineBoard.cs" Link="app\LineBoard.cs" />
    <Compile Include="..\LushbdoCompanion\OcrRows.cs" Link="app\OcrRows.cs" />
    <Compile Include="..\LushbdoCompanion\FrameDelta.cs" Link="app\FrameDelta.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="RapidOcrNet" Version="4.0.2" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.6" />
  </ItemGroup>

</Project>
