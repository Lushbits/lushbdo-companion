<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 10.0.19041 stays the OS floor â€” it is what makes
         Windows.Graphics.Capture and Windows.Media.Ocr reachable. Targeting
         22621 additionally projects the Windows 11 API that turns off the
         yellow capture border; its use is runtime-guarded via ApiInformation,
         so the exe still runs on 19041. -->
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Per-monitor DPI awareness makes picked coordinates and capture frames
         share one physical-pixel space; the crop copies pixels by pointer. -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>0.3.1</Version>
    <AssemblyTitle>Lushbdo Companion</AssemblyTitle>
    <Product>Lushbdo Companion</Product>
    <!-- Self-contained single file keeps "download the app" one .exe: the
         .NET runtime rides inside it, so nothing is installed on the PC.
         Settings live in %APPDATA%; the exe can sit anywhere. -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- Native libs (the WindowsDesktop pack's *_cor3.dll set) ride inside the
         exe too and self-extract at first run; without this they land as
         loose DLLs beside the exe and break the one-file release. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <!-- DPAPI, so the paired token is not plaintext on disk. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

</Project>
