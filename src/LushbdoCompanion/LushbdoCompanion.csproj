<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 10.0.19041 stays the OS floor â€” it is what makes
         Windows.Graphics.Capture and Windows.Media.Ocr reachable. Targeting
         22621 additionally projects the Windows 11 API that turns off the
         yellow capture border; its use is runtime-guarded via ApiInformation,
         so the exe still runs on 19041. -->
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Per-monitor DPI awareness makes picked coordinates and capture frames
         share one physical-pixel space; the crop copies pixels by pointer. -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>0.5.0</Version>
    <AssemblyTitle>Lushbdo Companion</AssemblyTitle>
    <Product>Lushbdo Companion</Product>
    <!-- Self-contained single file keeps "download the app" one .exe: the
         .NET runtime rides inside it, so nothing is installed on the PC.
         Settings live in %APPDATA%; the exe can sit anywhere. -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- Native libs (the WindowsDesktop pack's *_cor3.dll set) ride inside the
         exe too and self-extract at first run; without this they land as
         loose DLLs beside the exe and break the one-file release. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <!-- DPAPI, so the paired token is not plaintext on disk. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <!-- PaddleOCR PP-OCRv5 through ONNX Runtime: the recognizer #18's bake-off
         picked, at nearly twice Windows.Media.Ocr's rows-read on the field
         corpus. Brings ONNX Runtime and SkiaSharp natives, which ride inside
         the exe via IncludeNativeLibrariesForSelfExtract above. -->
    <PackageReference Include="RapidOcrNet" Version="4.0.2" />
  </ItemGroup>

  <!-- The four model files travel as embedded resources and are unpacked to
       %LOCALAPPDATA% on first run (see OcrModels): the release is one .exe and
       a loose models\ folder beside it would be an install. @(Models) is the
       item RapidOcrNet's own targets declare over its package folder. -->
  <Target Name="EmbedOcrModels" BeforeTargets="PrepareForBuild">
    <ItemGroup>
      <EmbeddedResource Include="@(Models)" LogicalName="LushbdoCompanion.models.%(Filename)%(Extension)" />
    </ItemGroup>
  </Target>

  <!-- ...which also means undoing the copy those targets make, or the publish
       folder ships them twice and the one-file promise is gone. -->
  <Target Name="DropLooseOcrModels" AfterTargets="CopyModelsPublish">
    <RemoveDir Directories="$(PublishDir)models" />
  </Target>

  <!-- ONNX Runtime ships its import libraries alongside the DLL. They are for
       linking C++, nothing loads them at runtime, and they are the only thing
       left in the publish folder that is not the exe. -->
  <Target Name="DropNativeImportLibs" BeforeTargets="ComputeFilesToPublish">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.lib'" />
    </ItemGroup>
  </Target>

</Project>
